# Admin console environment variables
# Mirror these values with apps/api/.env and apps/web/.env.local so every service shares the
# same Google credentials during development.
NEXT_PUBLIC_API_BASE=http://127.0.0.1:3006
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:3006
PLACES_API_KEY="__REPLACE_WITH_SERVER_PLACES_API_KEY__" # Replace via README step 5
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY="__REPLACE_WITH_BROWSER_MAPS_API_KEY__" # Replace via README step 5
GOOGLE_MAPS_REFERER=http://localhost:3007/ # Update if admin dev runs on another port
