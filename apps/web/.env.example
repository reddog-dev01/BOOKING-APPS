# When running via docker compose the server Google keys come from apps/api/.env.
# Keep this file in sync if you override values locally. Replace the placeholder via README step 5.
# Update GOOGLE_MAPS_REFERER if your Next.js dev server switches to 3000 or 3008.
PLACES_API_KEY="__REPLACE_WITH_SERVER_PLACES_API_KEY__"
GOOGLE_MAPS_REFERER=http://localhost:3005/
