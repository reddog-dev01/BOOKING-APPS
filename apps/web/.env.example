# When running via docker compose the server Google keys come from apps/api/.env.
# Keep this file in sync if you override values locally.
PLACES_API_KEY=__REPLACE_WITH_SERVER_PLACES_KEY__  # Same IP-restricted backend key as apps/api/.env (e.g. AIzaSyB3RRbbqQKUFLsTlw_SnDa8io3bKbx2Kuo)
GOOGLE_MAPS_REFERER=http://localhost:3005/
