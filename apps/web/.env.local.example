# Browser bundle envs; keep in sync with apps/api/.env when running via Docker.
# Provide real Google API keys with billing + restrictions applied before running locally.
PLACES_API_KEY="__YOUR_GOOGLE_PLACES_API_KEY__"
GOOGLE_MAPS_REFERER=http://localhost:3005/
NEXT_PUBLIC_API_BASE=http://127.0.0.1:3006
INTERNAL_API_BASE=http://127.0.0.1:3006
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY="__YOUR_GOOGLE_MAPS_BROWSER_API_KEY__"
NEXT_PUBLIC_QUOTE_PATH=/pricing/quote
NEXT_PUBLIC_BOOKINGS_PATH=/bookings
