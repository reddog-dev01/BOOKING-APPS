{
  "name": "api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "pnpm run predev && pnpm exec concurrently -k -n tsc,node \"pnpm run build:watch\" \"pnpm run start:watch\"",
    "build": "pnpm exec tsc -p tsconfig.build.json",
    "build:watch": "pnpm exec tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "predev": "pnpm -w prisma:generate && pnpm run build",
    "start": "node dist/main.js",
    "start:prod": "NODE_ENV=production node dist/main.js",
    "prestart:prod": "pnpm run prisma:generate",
    "start:watch": "node --watch --watch-path dist dist/main.js",
    "prisma:generate": "pnpm -w prisma:generate",
    "prisma:migrate:deploy": "pnpm -w prisma:migrate:deploy",
    "prebuild": "pnpm run prisma:generate",
    "prebuild:watch": "pnpm run prisma:generate",
    "prestart:watch": "pnpm run prisma:generate",
    "db:seed": "pnpm exec prisma db seed --schema=packages/db/prisma/schema.prisma",
    "test": "pnpm exec jest --config jest.config.ts",
    "test:watch": "pnpm exec jest --config jest.config.ts --watch"
  },
  "dependencies": {
    "@fastify/compress": "^8.1.0",
    "@fastify/cors": "^11.1.0",
    "@fastify/helmet": "^13.0.2",
    "@fastify/rate-limit": "^10.3.0",
    "@nestjs/common": "^11.1.8",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.1.8",
    "@nestjs/platform-fastify": "^11.1.8",
    "@nestjs/swagger": "^11.2.1",
    "@nestjs/throttler": "^6.4.0",
    "@prisma/client": "6.18.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.0",
    "fastify": "^5.6.1",
    "pino": "^9",
    "pino-pretty": "^11",
    "prisma": "6.18.0",
    "reflect-metadata": "^0.2.2",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^10",
    "@nestjs/schematics": "^10",
    "@nestjs/testing": "^11.1.8",
    "@types/node": "^20",
    "typescript": "^5"
  }
}
