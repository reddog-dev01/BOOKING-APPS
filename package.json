{
  "name": "booking-monorepo",
  "private": true,
  "scripts": {
    "build": "pnpm -r build",
    "db:reset": "pnpm exec prisma migrate reset --force --schema=packages/db/prisma/schema.prisma && pnpm exec prisma db seed --schema=packages/db/prisma/schema.prisma",
    "db:seed": "pnpm exec prisma db seed --schema=packages/db/prisma/schema.prisma",
    "dev": "node ./scripts/dev.mjs",
    "check:google-keys": "node ./scripts/check-google-keys.mjs",
    "lint": "pnpm -r lint",
    "prisma:format": "pnpm exec prisma format --schema=packages/db/prisma/schema.prisma",
    "prisma:generate": "pnpm exec prisma generate",
    "prisma:migrate:deploy": "pnpm exec prisma migrate deploy",
    "prisma:migrate:dev": "pnpm exec prisma migrate dev",
    "prisma:studio": "pnpm exec prisma studio --schema=packages/db/prisma/schema.prisma",
    "prisma:validate": "pnpm exec prisma validate",
    "start": "concurrently -n web,api -c green,cyan \"pnpm --filter web start\" \"pnpm --filter api start\"",
    "apply:google-keys": "node ./scripts/apply-google-keys.mjs"
  },
  "dependencies": {
    "@prisma/client": "6.18.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^22.18.12",
    "concurrently": "^9.0.1",
    "dotenv": "^17.2.3",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "prisma": "6.18.0",
    "ts-jest": "^29.4.5"
  },
  "packageManager": "pnpm@10.17.1",
  "prisma": {
    "seed": "node packages/db/prisma/seed.cjs"
  },
  "pnpm": {
    "overrides": {
    "@nestjs/testing": "^11.0.0",
      "@nestjs/throttler": "^6.0.0",
      "tailwindcss": "3.4.17"
    },
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "prisma",
      "sharp",
      "@tailwindcss/oxide"
    ]
  }
}
